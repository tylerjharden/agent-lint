{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "npm test"
  },
  "mutate": ["src/**/*.js", "src/**/*.ts", "!src/**/*.test.*", "!src/**/*.spec.*"],
  "concurrency": 1,
  "coverageAnalysis": "off",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 80
  }
}
