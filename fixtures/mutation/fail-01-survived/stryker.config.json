{
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test test/*.js"
  },
  "mutate": ["src/is-positive.js"],
  "concurrency": 1,
  "coverageAnalysis": "off",
  "inPlace": false,
  "cleanTempDir": true,
  "timeoutMS": 5000,
  "dryRunTimeoutMinutes": 1,
  "logLevel": "error",
  "fileLogLevel": "off",
  "reporters": ["clear-text"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 80
  }
}
